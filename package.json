{
  "name": "bitable-print",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "output": "dist",
  "description": "飞书多维表格打印插件（BitablePrint）— 侧边栏插件，模板化打印与导出 PDF",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "pack": "node scripts/pack.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/selftest.ts --bundle --platform=node --format=cjs --target=node20 --outfile=test/selftest.cjs --log-level=warning && node test/selftest.cjs",
    "test:skeleton": "esbuild test/skeleton-test.ts --bundle --platform=node --format=cjs --target=node20 --outfile=test/skeleton-test.cjs --log-level=warning && node test/skeleton-test.cjs",
    "test:lib": "node --experimental-strip-types src/lib/__selftest.mts",
    "test:render": "node --experimental-strip-types src/render/__selftest.mts",
    "test:import": "node --experimental-strip-types src/import/__selftest.mts",
    "test:e2e": "node test/e2e-smoke.mjs",
    "shot": "node test/shot.mjs",
    "test:all": "node test/run-node-suites.mjs"
  },
  "dependencies": {
    "@lark-base-open/js-sdk": "^0.5.0",
    "jszip": "^3.10.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
